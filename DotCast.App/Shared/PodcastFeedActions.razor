<section id="podcast-options" class="feed-help" data-podcast-feed>
    <h3>@Ux.Text("PodcastInstructionsTitle")</h3>
    <p>@Ux.Text("PodcastInstructions")</p>
    <div data-feed-output hidden>
        <label for="@inputId">@Ux.Text("FeedUrl")</label>
        <input id="@inputId" class="form-control" data-feed-url readonly />
    </div>
    <div class="feed-actions">
        <button type="button" class="secondary-action" onclick="DotCastUi.copyPodcastFeed(this)"
                data-feed-endpoint="@FeedEndpoint" data-preparing="@Ux.Text("PreparingFeed")"
                data-copied="@Ux.Text("FeedCopied")" data-copy-manually="@Ux.Text("CopyManually")" data-failed="@Ux.Text("FeedFailed")">@Ux.Text("CopyFeed")</button>
        <button type="button" class="secondary-action" onclick="DotCastUi.preparePodcastPlayer(this)"
                data-player-endpoint="@PlayerEndpoint(PodcastPlayer.Overcast)" data-preparing="@Ux.Text("PreparingFeed")" data-failed="@Ux.Text("FeedFailed")"
                data-continue="@Ux.Format("ContinueInPodcastApp", "Overcast")" data-ready="@Ux.Format("PodcastAppReady", "Overcast")">@Ux.Format("OpenInPodcastApp", "Overcast")</button>
        <button type="button" class="secondary-action" onclick="DotCastUi.preparePodcastPlayer(this)"
                data-player-endpoint="@PlayerEndpoint(PodcastPlayer.PocketCasts)" data-preparing="@Ux.Text("PreparingFeed")" data-failed="@Ux.Text("FeedFailed")"
                data-continue="@Ux.Format("ContinueInPodcastApp", "Pocket Casts")" data-ready="@Ux.Format("PodcastAppReady", "Pocket Casts")">@Ux.Format("OpenInPodcastApp", "Pocket Casts")</button>
        <button type="button" class="secondary-action" onclick="DotCastUi.preparePodcastPlayer(this)"
                data-player-endpoint="@PlayerEndpoint(PodcastPlayer.AntennaPod)" data-preparing="@Ux.Text("PreparingFeed")" data-failed="@Ux.Text("FeedFailed")"
                data-continue="@Ux.Format("ContinueInPodcastApp", "AntennaPod")" data-ready="@Ux.Format("PodcastAppReady", "AntennaPod")">@Ux.Format("OpenInPodcastApp", "AntennaPod")</button>
    </div>
    <p data-feed-status role="status" aria-live="polite"></p>
    <div data-player-output hidden>
        <a class="primary-action" data-player-link rel="noreferrer"></a>
    </div>
</section>
