<section id="podcast-options" class="feed-help" data-podcast-feed>
    <h3>@Ux.Text("PodcastInstructionsTitle")</h3>
    <p>@Ux.Text("PodcastInstructions")</p>
    <div data-feed-output hidden>
        <label for="@inputId">@Ux.Text("FeedUrl")</label>
        <input id="@inputId" class="form-control" data-feed-url readonly />
    </div>
    <div class="feed-actions">
        <button type="button" class="secondary-action" onclick="DotCastUi.copyPodcastFeed(this)"
                data-feed-endpoint="@FeedEndpoint" data-preparing="@Ux.Text("PreparingFeed")"
                data-copied="@Ux.Text("FeedCopied")" data-copy-manually="@Ux.Text("CopyManually")" data-failed="@Ux.Text("FeedFailed")">@Ux.Text("CopyFeed")</button>
        <a class="secondary-action" href="@PlayerEndpoint(PodcastPlayer.Overcast)" target="_blank" rel="noopener noreferrer">@Ux.Format("OpenInPodcastApp", "Overcast")</a>
        <a class="secondary-action" href="@PlayerEndpoint(PodcastPlayer.PocketCasts)" target="_blank" rel="noopener noreferrer">@Ux.Format("OpenInPodcastApp", "Pocket Casts")</a>
        <a class="secondary-action" href="@PlayerEndpoint(PodcastPlayer.AntennaPod)" target="_blank" rel="noopener noreferrer">@Ux.Format("OpenInPodcastApp", "AntennaPod")</a>
    </div>
    <p data-feed-status role="status" aria-live="polite"></p>
</section>
