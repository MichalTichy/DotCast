<div class="file-upload" id="@containerId">
    <div class="file-upload-dropzone">
        <label for="@filePickerId">@Label</label>
        <small>@Ux.Text("SelectUploadFiles")</small>
        <input type="file" id="@filePickerId" multiple="@Multiple" aria-describedby="@helpId" />
    </div>
    <p id="@helpId">@Ux.Text("UploadHelp")</p>
    <div id="@progressContainerId" class="file-upload-progress" aria-live="polite"></div>
</div>
