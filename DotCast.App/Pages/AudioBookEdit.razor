@page "/AudioBook/{Id}/edit"
@inherits AppPage
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="BeforeNavigation" />
<section class="edit-page">
    @if (Data is null)
    {
        <a class="text-button" href="@LibraryUrl">@Ux.Text("BackLibrary")</a>
        <p role="@(LoadError is null ? "status" : "alert")">@(LoadError ?? Ux.Text("LoadingBooks"))</p>
    }
    else
    {
        <header class="edit-hero">
            @if (!string.IsNullOrWhiteSpace(Data.AudioBookInfo.ImageUrl)) { <div class="edit-cover"><img src="@Data.AudioBookInfo.ImageUrl" alt="" /></div> }
            <div class="edit-hero-copy"><a class="text-button" href="@LibraryUrl">@Ux.Text("BackLibrary")</a>
                <p class="cinema-eyebrow">@Ux.Text("EditBook")</p><h1>@Data.AudioBookInfo.Name</h1>
                <p>@Data.AudioBookInfo.AuthorName · @Ux.Duration(Data.AudioBookInfo.Duration)</p>
            </div>
        </header>
        <div class="editor-save-bar">
            <span role="status">@Ux.Text(IsDirty ? "UnsavedChanges" : "AllChangesSaved")</span>
            <button class="secondary-action" @onclick="Save" disabled="@(!IsDirty || IsSaving)">@Ux.Text(IsSaving ? "Saving" : "Save")</button>
            <button class="primary-action" @onclick="SaveAndExit" disabled="@IsSaving">@Ux.Text("SaveExit")</button>
            @if (Message != null) { <span role="status">@Message</span> }
        </div>
        <nav class="cinema-tabs" role="tablist" aria-label="@Ux.Text("EditSections")">
            @foreach (var section in new[] { "metadata", "files", "chapters" })
            {
                <button id="@("edit-tab-" + section)" role="tab" aria-selected="@((ActiveTab == section).ToString().ToLowerInvariant())" aria-controls="edit-panel" tabindex="@(ActiveTab == section ? 0 : -1)" class="@(ActiveTab == section ? "is-active" : "")" @onclick="() => ActiveTab = section">@Ux.Text("Tab_" + section)</button>
            }
        </nav>
        <main id="edit-panel" class="edit-panel" role="tabpanel" aria-labelledby="@("edit-tab-" + ActiveTab)">
            <fieldset disabled="@IsSaving">
                @if (ActiveTab == "metadata")
                {
                    <section class="metadata-grid">
                        <label for="book-name">@Ux.Text("Name")<input id="book-name" class="form-control" @bind="Data.AudioBookInfo.Name" @bind:event="oninput" required /></label>
                        <label for="book-author">@Ux.Text("Author")<input id="book-author" class="form-control" @bind="Data.AudioBookInfo.AuthorName" @bind:event="oninput" /></label>
                        <label for="book-series">@Ux.Text("Series")<input id="book-series" class="form-control" @bind="Data.AudioBookInfo.SeriesName" @bind:event="oninput" /></label>
                        <label for="book-order">@Ux.Text("SeriesOrder")<input id="book-order" class="form-control" type="number" @bind="Data.AudioBookInfo.OrderInSeries" min="0" /></label>
                        <label for="book-rating">@Ux.Text("Rating")<input id="book-rating" class="form-control" type="number" @bind="Data.Rating" min="0" max="100" /><small>@Ux.Text("RatingHelp")</small></label>
                        <label class="wide-field" for="book-description">@Ux.Text("Description")<textarea id="book-description" class="form-control" @bind="Data.AudioBookInfo.Description" @bind:event="oninput" rows="6"></textarea></label>
                        <section class="wide-field category-editor"><h2>@Ux.Text("Categories")</h2>
                            <div class="drawer-tags">@foreach (var category in Data.AudioBookInfo.Categories) { <button class="filter-pill" aria-label="@Ux.Format("RemoveCategory", category.Name)" @onclick="() => RemoveCategory(category)">@category.Name ×</button> }</div>
                            <label for="add-category">@Ux.Text("AddCategory")</label><select id="add-category" class="form-control" value="" @onchange="AddCategory"><option value="">@Ux.Text("ChooseCategory")</option>
                                @foreach (var category in MissingCategories) { <option value="@category.Name">@category.Name</option> }
                            </select>
                        </section>
                        <button class="danger-action" @onclick="DeleteAndExit" disabled="@IsDeleting">@Ux.Text(IsDeleting ? "Deleting" : "Delete")</button>
                    </section>
                }
                else if (ActiveTab == "files")
                {
                    <section><h2>@Ux.Text("Tab_files")</h2><p>@Ux.Text("ReplacementHelp")</p><p>@Ux.Text("UploadHelp")</p><p>@Ux.Text("UploadLimits")</p>
                        @if (IsDirty) { <p role="status">@Ux.Text("SaveBeforeUpload")</p> }
                        else { <FileUpload PresignedUrlFactory="CreatePresignedUrl" Completed="UploadCompleted" /> }
                    </section>
                }
                else
                {
                    <section><div class="section-heading"><div><h2>@Ux.Text("Tab_chapters")</h2><p>@Ux.Text("ChapterOrderHelp")</p></div>
                        <button class="secondary-action" @onclick="SortByName">@Ux.Text("SortName")</button>
                        @if (PreviousChapterOrder != null) { <button class="text-button" @onclick="UndoOrder">@Ux.Text("UndoOrder")</button> }
                    </div>
                        <ol class="chapter-list">
                            @foreach (var chapter in Data.AudioBookInfo.Chapters)
                            {
                                <li class="chapter-row" @key="chapter.FileId"><span>@chapter.Name</span><small>@Ux.Duration(chapter.Duration)</small>
                                    <button class="text-button" disabled="@(chapter == Data.AudioBookInfo.Chapters.First())" aria-label="@Ux.Format("MoveUp", chapter.Name)" @onclick="() => MoveChapter(chapter, -1)">↑</button>
                                    <button class="text-button" disabled="@(chapter == Data.AudioBookInfo.Chapters.Last())" aria-label="@Ux.Format("MoveDown", chapter.Name)" @onclick="() => MoveChapter(chapter, 1)">↓</button>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </fieldset>
        </main>
    }
</section>
@if (PendingLocation is not null)
{
    <UxDialog Label="@Ux.Text("UnsavedChanges")" Dismiss="Stay">
        <h2>@Ux.Text("UnsavedChanges")</h2><p>@Ux.Text("LeaveDraftHelp")</p>
        <div class="drawer-actions"><button class="secondary-action" autofocus @onclick="Stay">@Ux.Text("KeepEditing")</button><button class="primary-action" disabled="@IsSaving" @onclick="SaveAndLeave">@Ux.Text("SaveLeave")</button><button class="danger-action" disabled="@IsSaving" @onclick="DiscardAndLeave">@Ux.Text("DiscardLeave")</button></div>
        @if (Message != null) { <p role="status">@Message</p> }
    </UxDialog>
}
