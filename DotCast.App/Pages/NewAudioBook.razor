@page "/NewAudioBook"
@inherits AppPage
<section class="upload-page">
    <header class="page-hero compact"><p class="cinema-eyebrow">@Ux.Text("NewBook")</p><h1>@Ux.Text("AddBook")</h1><p>@Ux.Text("AddBookHelp")</p></header>
    <main class="upload-panel">
        <label for="new-book-name">@Ux.Text("BookName")</label>
        <input id="new-book-name" class="form-control" placeholder="@Ux.Text("EnterBookName")" value="@AudioBookName" @oninput="BookNameTextChanged" disabled="@(IsProcessingRunning || IsUploading)" />
        <p role="status" aria-live="polite">@(IsChecking ? Ux.Text("CheckingName") : StatusMessage)</p>
        @if (ExistingId is not null) { <a class="secondary-action" href="@($"/AudioBook/{Uri.EscapeDataString(ExistingId)}/edit")">@Ux.Text("OpenExisting")</a> }
        @if (AudioBookId is not null) { <details class="generated-id"><summary>@Ux.Text("StorageDetails")</summary><code>@AudioBookId</code></details> }
        <p>@Ux.Text("UploadLimits")</p><p>@Ux.Text("UploadOrder")</p>
        @if (ReadyForUpload && !IsProcessingRunning) { <FileUpload PresignedUrlFactory="GetPresignedUrls" Started="() => IsUploading = true" Completed="UploadCompleted" Label="@Ux.Text("UploadBookFiles")" /> }
        else if (!IsProcessingRunning && ExistingId is null) { <p>@Ux.Text("EnterNameToUpload")</p> }
        @if (IsProcessingRunning) { <p role="status">@Ux.Text("ProcessingOpenEditor")</p> }
    </main>
</section>
